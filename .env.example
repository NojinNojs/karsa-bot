# ==============================================================================
# KOTA MANDIRI 16-BIT TYCOON — KONFIGURASI LINGKUNGAN (.env)
# Salin file ini menjadi `.env` lalu isi kredensial Discord Bot Anda.
# Jika DISCORD_TOKEN dikosongkan, menjalankan `bun start` atau `bun start --demo`
# akan otomatis masuk ke Mode Demo CLI & Test Render Lokal.
# ==============================================================================

# [WAJIB UNTUK MODE BOT DISCORD]
# Token Bot dari Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID / Client ID dari Discord Developer Portal -> General Information
DISCORD_CLIENT_ID=

# [OPSIONAL — DIREKOMENDASIKAN SAAT DEVELOPMENT]
# Server ID (Guild ID) untuk registrasi Slash Command instan (< 1 detik).
# Jika dikosongkan, Slash Command akan didaftarkan secara Global (butuh hingga 1 jam).
DISCORD_GUILD_ID=

# [DATABASE]
# Lokasi file SQLite lokal (otomatis dibuat beserta direktori jika belum ada)
DATABASE_PATH=./data/kota-mandiri.sqlite

# [MONETISASI — DISCORD APP SUBSCRIPTIONS (PREMIUM)]
# SKU ID untuk paket langganan "Walikota VIP Pass" (Rp15.000/bulan)
# dari Discord Developer Portal -> Monetization -> Subscriptions
DISCORD_PREMIUM_SKU_ID=

# [OPSIONAL — PENGATURAN RUNTIME]
# Set ke "true" untuk memaksa registrasi ulang Slash Command saat startup
REGISTER_COMMANDS_ON_BOOT=true
