{
  "name": "kota-mandiri-bot",
  "version": "1.5.0",
  "description": "Karsa — Bot RPG Ekonomi & Tycoon Nusantara untuk Discord dengan Kartu Pixel-Art Canvas, Usaha Lokal, dan Koperasi Komunitas.",
  "type": "module",
  "module": "src/index.ts",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build-fonts": "bun run scripts/build-fonts.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:render": "bun run src/test-render.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "bun run src/index.ts --reset-db",
    "lint": "biome check src tests",
    "format": "biome check --write src tests"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
